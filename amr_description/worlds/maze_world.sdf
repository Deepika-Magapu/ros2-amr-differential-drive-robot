<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="nav_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary: the occupancy map uses the same 0.2 m wall boxes. -->
    <model name="wall_north"><static>true</static><pose>0 6 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>12.2 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.2 0.2 1</size></box></geometry></visual></link>
    </model>
    <model name="wall_south"><static>true</static><pose>0 -6 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>12.2 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.2 0.2 1</size></box></geometry></visual></link>
    </model>
    <model name="wall_east"><static>true</static><pose>6 0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 12 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12 1</size></box></geometry></visual></link>
    </model>
    <model name="wall_west"><static>true</static><pose>-6 0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 12 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12 1</size></box></geometry></visual></link>
    </model>

    <!-- Three alternating 3.9 m openings leave room for the base and turning margin. -->
    <model name="maze_wall_1"><static>true</static><pose>-1.95 -2.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>7.9 0.15 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.9 0.15 1</size></box></geometry></visual></link>
    </model>
    <model name="maze_wall_2"><static>true</static><pose>1.95 0.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>7.9 0.15 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.9 0.15 1</size></box></geometry></visual></link>
    </model>
    <model name="maze_wall_3"><static>true</static><pose>-1.95 3.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>7.9 0.15 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.9 0.15 1</size></box></geometry></visual></link>
    </model>
  </world>
</sdf>
